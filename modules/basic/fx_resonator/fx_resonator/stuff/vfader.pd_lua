local vfader = pd.Class:new():register("vfader")function math.clamp(x, min, max)    if x < min then return min end    if x > max then return max end    return xendfunction vfader:initialize(sel, atoms)    self.value = 0    self.inlets = 1    self.outlets = 1    self.gui = 1    	self.shift = 0    self.slider_position_y = 0.5    self.bg1 = Colors.background    self.bg2 = Colors.background    self.fg = Colors.foreground    self:set_size(38, 55)    return trueendfunction vfader:mouse_down(x, y)    local width, height = self:get_size()    self.mouse_down_y = y    self.last_mouse_y = y    self.mouse_down_slider_y = (1.0 - self.slider_position_y) * height  --  self:repaint()endfunction vfader:mouse_drag(x, y)    local width, height = self:get_size()     self.slider_position_y = math.clamp (self.slider_position_y + (self.last_mouse_y - y) / height / 5.0 , 0, 1)	    self.mouse_down_y = y    self.last_mouse_y = y    self.mouse_down_slider_y = (1.0 - self.slider_position_y) * height   -- self:repaint()    self:in_1_bang()endfunction vfader:mouse_up(x, y)   self.button = 0--  self:repaint()endfunction vfader:in_1_bang()    local y = self:scale_value(self.slider_position_y, 0, 127)    self:outlet(1, "float", {y})  --self:repaint()endfunction vfader:in_1_float(f)    local width, height = self:get_size()    self.slider_position_y = self:unscale_value(f, 0, 127)   -- self:repaint()    self:in_1_bang()endfunction vfader:in_1_set(atoms)    self.slider_position_y = self:unscale_value(atoms[1], 0, 127) --   self:repaint();endfunction vfader:in_1_shift(atoms)    local width, height = self:get_size()    self.mouse_down_y = self.last_mouse_y    self.mouse_down_slider_y = self.slider_position_y * height    self.shift = atoms[1]endfunction vfader:in_1_back_color(atoms)endfunction vfader:in_1_front_color(atoms)endfunction vfader:in_1_bg_color(atoms)    self.bg1 = atoms    self.bg2 = atoms  --  self:repaint()endfunction vfader:in_1_bgcolor1(atoms)    self.bg1 = atoms --   self:repaint()endfunction vfader:in_1_bgcolor2(atoms)    self.bg2 = atoms--    self:repaint()endfunction vfader:in_1_fg_color(atoms)    self.fg = atoms--    self:repaint()endfunction vfader:scale_value(value, min, max)    return min + (max - min) * valueendfunction vfader:unscale_value(value, min, max)    return (value - min) / (max - min)endfunction vfader:paint(g)     g:fill_all()endfunction vfader:nop()    if self.mustdraw == 1 then        self.mustdraw = 0        local width, height = self:get_size()        local y = (1.0 - self.slider_position_y) * height        if type(self.bg1) == "number" then                g:set_color(self.bg1)        elseif type(self.bg1) == "table" then            g:set_color(table.unpack(self.bg1))        end        g:fill_all()        if type(self.bg2) == "number" then            g:set_color(self.bg2)        elseif type(self.bg2) == "table" then            g:set_color(table.unpack(self.bg2))        end    	    if type(self.fg) == "number" then            g:set_color(self.fg)        elseif type(self.fg) == "table" then            g:set_color(table.unpack(self.fg))        end	        g:fill_rect(0, y, width, height - y)    end end