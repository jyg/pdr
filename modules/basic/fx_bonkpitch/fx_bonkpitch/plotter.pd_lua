local plotter = pd.Class:new():register("plotter")function plotter:initialize(sel, atoms)    self.value = 0    self.inlets = 2    self.outlets = 1    self.gui = 1	self.height = 100	self.width = 100	self.mouse_x = 0	self.mouse_y = 0    self:set_size(100,100)	self.tabname = ""	self.points = {}   	self.showcursor = 0	self.colors = {		{ r = 200, g = 0, b = 0 },		{ r = 25,  g = 100, b = 0 },		{ r = 255,  g = 0, b = 255 },		{ r = 0,  g = 110, b = 0 },		{ r = 0,  g = 0, b = 255 },		{ r = 0,  g = 0, b = 0 },		{ r = 128,  g = 128, b = 128 },		{ r = 0,  g = 110, b = 90 }	}	self.highlight = {}	    return trueendfunction plotter:in_1_setpoint(atoms)	local key = atoms[1]	local value = self.points[key]	if value == nil then		self.points[key]={atoms[2],atoms[3], { r = 0, g = 0, b = 0 },2}	else		self.points[key]={atoms[2],atoms[3],value[3],value[4]}	end	self:repaint()	--self:repaint(2)endfunction plotter:in_1_pointcolor(atoms)	local key = atoms[1]	local value = self.points[key]	if value == nil then return	else 		local my_class = (atoms[2])%#self.colors + 1		local my_color = self.colors[my_class]		self.points[key]={value[1],value[2],my_color,value[4]}		self:repaint()	--	self:repaint(2)	endendfunction plotter:in_1_pointsize(atoms)	local key = atoms[1]	local value = self.points[key]	if value == nil then return	else 		--local value = self.points[key]		self.points[key]={value[1],value[2],value[3],atoms[2]}		self:repaint()	--	self:repaint(2)	endendfunction plotter:in_1_highlight(atoms)	--erase previous	for k, v in pairs(self.highlight) do 		self.highlight[k] = nil 	end		for k=1, #atoms do		self.highlight[k]=atoms[k]		--pd.post(string.format("highlighting index %g",self.highlight[k]))	end	--pd.post(string.format("highlighted items : %g",#self.highlight))	self:repaint()	--self:repaint(4)end	function plotter:in_1_removepoint(atoms)	self.points[atoms[1]] = nil	self.highlight[atoms[1]] = nil	self:repaint()	--self:repaint(2)	--self:repaint(4)endfunction plotter:in_1_repaint()	self:repaint()endfunction plotter:in_1_clear()	for k, v in pairs(self.points) do 		self.points[k] = nil	end	for k, v in pairs(self.highlight) do 		self.highlight[k] = nil 	end		self:repaint()	--self:repaint(2)	--self:repaint(4)endfunction plotter:in_1_showcursor(atoms)	self.showcursor = atoms[1]	self:repaint()	--self:repaint(3)endfunction plotter:in_1_size(atoms)    self.width = atoms[1]	self.height = atoms[2]    self:outlet(1, "setsize", {self.width, self.height})    self:set_size(self.width, self.height)	self:repaint()endfunction plotter:mouse_down(x, y)    local width, height = self:get_size()    self.mouse_x = x;	self.mouse_y = y;	self:outlet(1, "add", {self.mouse_x/width,self.mouse_y/height})	if self.showcursor then		self:repaint()	--	self:repaint(3)	endendfunction plotter:mouse_drag(x, y)    local width, height = self:get_size()	self.mouse_x = x;	self.mouse_y = y;	self:outlet(1, "update", {self.mouse_x/width,self.mouse_y/height})	if self.showcursor then		self:repaint()	--	self:repaint(3)	end endfunction plotter:mouse_up(x, y)    local width, height = self:get_size()	self.mouse_x = x;	self.mouse_y = y;	self:outlet(1, "remove", {x/width,y/height})	self:repaint()	--	self:repaint(3)end			-- paint backgroundfunction plotter:paint(g)	local width, height = self:get_size()	g:set_color(0)	g:fill_all()			-- paint points--function plotter:paint_layer_2(g)	local width, height = self:get_size()	for k, v in pairs(self.points) do		local halfsize=v[4]/2		g:set_color(v[3].r,v[3].g,v[3].b)  		g:fill_ellipse(v[1]*width-halfsize,v[2]*height-halfsize, halfsize*2,halfsize*2)	end--end				-- paint cursor--function plotter:paint_layer_3(g)	g:set_color(1)    if self.showcursor == 1 then		g:fill_rect(self.mouse_x-5, self.mouse_y-5, 10,10)	end--end			-- paint highlighted points--function plotter:paint_layer_4(g)		local width, height = self:get_size()	for k, v in pairs(self.highlight) do 		local my_point = self.points[v]		local halfsize=my_point[4]*1.2/2		g:set_color(my_point[3].r,my_point[3].g,my_point[3].b)  		g:fill_ellipse(my_point[1]*width-halfsize,my_point[2]*height-halfsize, halfsize*2, halfsize*2)	endend